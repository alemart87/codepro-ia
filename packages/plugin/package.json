{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@codepro-ai/plugin",
  "version": "1.0.0",
  "description": "Plugin system for CodePro AI",
  "type": "module",
  "license": "MIT",
  "author": "Rafael Martinez",
  "repository": {
    "type": "git",
