#!/usr/bin/env node

import { spawn } from "child_process";
import { fileURLToPath } from "url";
import { dirname, join } from "path";
import { existsSync } from "fs";
import { platform, arch } from "os";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Check for custom binary path
const envPath = process.env.CODEPRO_BIN_PATH;
if (envPath && existsSync(envPath)) {
  run(envPath);
}

// Platform and architecture mapping
const platformMap = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
};

const archMap = {
  x64: "x64",
  arm64: "arm64",
};

const currentPlatform = platformMap[platform()] || platform();
const currentArch = archMap[arch()] || arch();

// Try to find prebuilt binary
const binaryName = currentPlatform === "windows" ? "opencode.exe" : "opencode";
const localBinary = join(__dirname, binaryName);

if (existsSync(localBinary)) {
  run(localBinary);
} else {
  console.log(`
╔══════════════════════════════════════════════════════════════════╗
║                     🦒 CodePro IA                                 ║
║                                                                   ║
║  Binaries not yet available via npm.                              ║
║                                                                   ║
║  To run CodePro IA, use one of these methods:                     ║
║                                                                   ║
║  1. Clone and run with Bun:                                       ║
║     git clone https://github.com/alemart87/codepro-ia             ║
║     cd codepro-ia                                                 ║
║     bun install                                                   ║
║     bun dev                                                       ║
║                                                                   ║
║  2. Or install Bun globally:                                      ║
║     npm install -g bun                                            ║
║                                                                   ║
╚══════════════════════════════════════════════════════════════════╝
`);
  process.exit(0);
}

function run(target) {
  const child = spawn(target, process.argv.slice(2), {
    stdio: "inherit",
  });

  child.on("error", (err) => {
    console.error("Error:", err.message);
    process.exit(1);
  });

  child.on("close", (code) => {
    process.exit(code || 0);
  });
}
